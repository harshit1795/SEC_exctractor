"""
Nexus Social Media Module

This module provides social media functionality, including user profiles,
friendships, messaging, groups, and forums.
"""

import streamlit as st
from pages.nexus_tabs import profile_tab, directory_tab, friends_tab, feed_tab

def render():
    """Renders the Nexus social media module."""
    st.title("🌐 Nexus Social")

    # Check for user authentication
    if not st.session_state.get("logged_in"):
        st.warning("Please log in to access Nexus.")
        return

    # Tab navigation
    tab1, tab2, tab3, tab4 = st.tabs(["Feed", "My Profile", "User Directory", "Friends"])

    with tab1:
        feed_tab.render()

    with tab2:
        profile_tab.render()

    with tab3:
        directory_tab.render()

    with tab4:
        friends_tab.render()

# Main execution
if __name__ == "__main__":
    render()
    